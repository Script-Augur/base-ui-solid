{
  "name": "@script-augur/base-ui-solid",
  "version": "0.0.1",
  "description": "Solid-idiomatic port of Base UI headless components",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Script-Augur/base-ui-solid.git",
    "directory": "packages/solid"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js",
      "default": "./dist/button.js"
    },
    "./separator": {
      "types": "./dist/separator.d.ts",
      "import": "./dist/separator.js",
      "default": "./dist/separator.js"
    },
    "./toggle": {
      "types": "./dist/toggle.d.ts",
      "import": "./dist/toggle.js",
      "default": "./dist/toggle.js"
    },
    "./toggle-group": {
      "types": "./dist/toggle-group.d.ts",
      "import": "./dist/toggle-group.js",
      "default": "./dist/toggle-group.js"
    },
    "./collapsible": {
      "types": "./dist/collapsible.d.ts",
      "import": "./dist/collapsible.js",
      "default": "./dist/collapsible.js"
    },
    "./accordion": {
      "types": "./dist/accordion.d.ts",
      "import": "./dist/accordion.js",
      "default": "./dist/accordion.js"
    },
    "./tabs": {
      "types": "./dist/tabs.d.ts",
      "import": "./dist/tabs.js",
      "default": "./dist/tabs.js"
    },
    "./progress": {
      "types": "./dist/progress.d.ts",
      "import": "./dist/progress.js",
      "default": "./dist/progress.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.2",
    "@script-augur/base-ui-utils": "workspace:*",
    "tabbable": "^6.2.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.6.3",
    "esbuild-plugin-solid": "^0.6.0",
    "jsdom": "^26.1.0",
    "solid-js": "^1.9.15",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite-plugin-solid": "^2.11.6",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  }
}
